Banco de dados:
create table pacientes(id int primary key auto_increment,
 nome varchar(100) not null,
  idade int(3) not null,
  sexo char(1) not null,
   telefone varchar(14) not null,
   email varchar(50) not null,
    senha varchar(20) not null);

 create table medicos(id int primary key auto_increment,
  nome varchar(100) not null,
   idade int(3) not null,
   sexo char(1) not null,
    telefone varchar(14) not null,
     email varchar(100) not null,
      especialidade varchar(30) not null,
       crm varchar(9) not null,
        senha varchar(20) not null);

  create table consultas(id int primary key auto_increment,
   data date not null,
    tipo varchar(10) not null,
     descricao varchar(100) not null,
      id_paciente int,
       id_medico int,
        constraint id_paciente foreign key (id_paciente) references pacientes(id),
         constraint id_medico foreign key (id_medico) references medicos(id));

adicionar uniqhe e uma nova coluna de tipo de usuario medico ou apciente.